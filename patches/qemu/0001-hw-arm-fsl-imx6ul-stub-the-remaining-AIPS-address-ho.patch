From 559056642bef4c1f0b14b43b1fd23cd6f939fc07 Mon Sep 17 00:00:00 2001
From: Charliechen114514 <725610365@qq.com>
Date: Wed, 26 Aug 2026 22:47:47 +0800
Subject: [PATCH 01/16] hw/arm: fsl-imx6ul: stub the remaining address
 holes (dcp/rngb/pxp/csi/tsc/iomuxc-snvs)

Boards derived from the i.MX6ULL 14x14 EVK enable DCP, RNGB, CSI, PXP and
the resistive TSC in their device trees. Upstream leaves those addresses
unmapped, so the matching drivers take external aborts during
of_platform_populate and kill PID 1 before the serial console comes up.

Stub all six so the drivers probe-fail softly instead. PXP and CSI reuse
the address constants already defined in the memory map enum; DCP/RNGB/TSC
have none, hence the literals.

iomuxc-snvs (0x02290000) is the SNVS-side pinmux. Real board trees mux
their GPIO5 pads (BOOT_MODE/TAMPER) through &iomuxc_snvs; kernels that
apply those pinctrl groups during probe (the peri-3v3 fixed regulator,
the spi-gpio bit-bang bus) take external aborts there, and the one that
lands on PID 1 kills the boot outright.

For the AES teaching board this closes the last raw holes in its tree.
---
 hw/arm/fsl-imx6ul.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/hw/arm/fsl-imx6ul.c b/hw/arm/fsl-imx6ul.c
index 1863558..9d00e1c 100644
--- a/hw/arm/fsl-imx6ul.c
+++ b/hw/arm/fsl-imx6ul.c
@@ -659,6 +659,25 @@ static void fsl_imx6ul_realize(DeviceState *dev, Error **errp)
                                     FSL_IMX6UL_ADCn_SIZE);
     }
 
+    /*
+     * Devices left as raw address holes upstream but enabled by real board
+     * trees (e.g. i.MX6ULL EVK derivatives with DCP/RNGB/CSI/PXP). Stub
+     * them so their drivers soft-fail instead of taking external aborts.
+     * dcp/rngb/tsc have no address constants defined, hence the literals.
+     * iomuxc-snvs is the SNVS-side pinmux: real board trees mux their
+     * GPIO5 pads (BOOT_MODE/TAMPER) through it, so mux-mode writes must
+     * be swallowed, not aborted on.
+     */
+    create_unimplemented_device("a7mpcore-dcp", 0x02280000, 4 * KiB);
+    create_unimplemented_device("a7mpcore-rngb", 0x02284000, 4 * KiB);
+    create_unimplemented_device("a7mpcore-pxp", FSL_IMX6UL_PXP_ADDR,
+                                FSL_IMX6UL_PXP_SIZE);
+    create_unimplemented_device("a7mpcore-csi", FSL_IMX6UL_CSI_ADDR,
+                                FSL_IMX6UL_CSI_SIZE);
+    create_unimplemented_device("a7mpcore-tsc", 0x02040000, 4 * KiB);
+    create_unimplemented_device("a7mpcore-iomuxc-snvs", 0x02290000,
+                                16 * KiB);
+
     /*
      * LCD
      */
