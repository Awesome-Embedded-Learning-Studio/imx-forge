diff --git a/include/hw/sensor/ap3216c.h b/include/hw/sensor/ap3216c.h
new file mode 100644
index 0000000..91c5350
--- /dev/null
+++ b/include/hw/sensor/ap3216c.h
@@ -0,0 +1,47 @@
+/*
+ * AP3216C ambient light / proximity / IR sensor.
+ *
+ * Minimal teaching model for the AES board (i2c1 @ 0x1e): register
+ * storage plus three injectable sample values (ir/als/ps) exposed as
+ * writable QOM properties, so a classroom or CI test can "shine a
+ * flashlight" at the sensor via QMP qom-set and watch the guest driver
+ * read it back through the real I2C path.
+ *
+ * Data register layout follows the datasheet as parsed by the Linux
+ * driver (drivers/misc/ap3216c on vendor trees; our imxaes teaching
+ * driver): IR is 10-bit (IR_H low 8 bits, IR_L low 2 bits hold the top
+ * two), ALS is plain 16-bit LE, PS is 10-bit (PS_H low 6 bits hold the
+ * top six, PS_L low 4 bits). The overflow/invalid flag bits are never
+ * set by this model.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#ifndef HW_SENSOR_AP3216C_H
+#define HW_SENSOR_AP3216C_H
+
+#include "hw/i2c/i2c.h"
+#include "qom/object.h"
+
+#define TYPE_AP3216C "ap3216c"
+OBJECT_DECLARE_SIMPLE_TYPE(AP3216CState, AP3216C)
+
+struct AP3216CState {
+    /*< private >*/
+    I2CSlave parent_obj;
+
+    /*< public >*/
+    uint8_t pointer;    /* current register index */
+    bool first_byte;    /* next tx byte is the register index */
+    uint8_t sysc;       /* 0x00 SYSTEMCONFIGURE */
+    uint8_t int_status; /* 0x01 INT STATUS */
+    uint8_t int_mirror; /* 0x02 INT MIRROR */
+
+    /* injectable sample data */
+    uint16_t ir;
+    uint16_t als;
+    uint16_t ps;
+};
+
+#endif /* HW_SENSOR_AP3216C_H */
