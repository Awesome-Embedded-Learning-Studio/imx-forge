diff --git a/hw/sensor/ap3216c.c b/hw/sensor/ap3216c.c
new file mode 100644
index 0000000..1d69f71
--- /dev/null
+++ b/hw/sensor/ap3216c.c
@@ -0,0 +1,140 @@
+/*
+ * AP3216C ambient light / proximity / IR sensor — teaching model.
+ *
+ * See include/hw/sensor/ap3216c.h for the design rationale. Register
+ * access follows the datasheet: the master writes a register index,
+ * then reads (auto-incrementing) or writes data. All registers are
+ * single-byte. Values for the six read-only data registers (0x0a..0x0f)
+ * are derived from the injectable ir/als/ps properties; everything else
+ * is plain storage.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sensor/ap3216c.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+static uint8_t ap3216c_read_reg(AP3216CState *s, uint8_t reg)
+{
+    switch (reg) {
+    case 0x00:
+        return s->sysc;
+    case 0x01:
+        return s->int_status;
+    case 0x02:
+        return s->int_mirror;
+    case 0x0a: /* IR_L: top two bits of IR in [1:0] */
+        return s->ir >> 8;
+    case 0x0b: /* IR_H: low eight bits of IR */
+        return s->ir & 0xff;
+    case 0x0c: /* ALS_L */
+        return s->als & 0xff;
+    case 0x0d: /* ALS_H */
+        return s->als >> 8;
+    case 0x0e: /* PS_L: top nibble of PS in [3:0] */
+        return (s->ps >> 4) & 0x0f;
+    case 0x0f: /* PS_H: low six bits of PS */
+        return s->ps & 0x3f;
+    default:
+        return 0;
+    }
+}
+
+static void ap3216c_event(I2CSlave *i2c, enum i2c_event event)
+{
+    AP3216CState *s = AP3216C(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->first_byte = true;
+    }
+}
+
+static uint8_t ap3216c_recv(I2CSlave *i2c)
+{
+    AP3216CState *s = AP3216C(i2c);
+
+    return ap3216c_read_reg(s, s->pointer++);
+}
+
+static int ap3216c_send(I2CSlave *i2c, uint8_t data)
+{
+    AP3216CState *s = AP3216C(i2c);
+
+    if (s->first_byte) {
+        s->pointer = data;
+        s->first_byte = false;
+        return 0;
+    }
+
+    switch (s->pointer) {
+    case 0x00:
+        s->sysc = data;
+        break;
+    case 0x01: /* INT_STATUS is clear-on-write */
+        s->int_status &= ~data;
+        break;
+    case 0x02:
+        s->int_mirror = data;
+        break;
+    default:
+        /* data registers are read-only; rest is R/O factory area */
+        break;
+    }
+    s->pointer++;
+    return 0;
+}
+
+static void ap3216c_reset_hold(Object *obj, ResetType type)
+{
+    AP3216CState *s = AP3216C(obj);
+
+    s->pointer = 0;
+    s->first_byte = true;
+    s->sysc = 0;
+    s->int_status = 0;
+    s->int_mirror = 0;
+
+    /* plausible indoor defaults; override via QMP qom-set ir/als/ps */
+    s->ir = 0x0150;
+    s->als = 0x0120;
+    s->ps = 0x00c8;
+}
+
+static void ap3216c_init(Object *obj)
+{
+    object_property_add_uint16_ptr(obj, "ir", &AP3216C(obj)->ir,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "als", &AP3216C(obj)->als,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "ps", &AP3216C(obj)->ps,
+                                   OBJ_PROP_FLAG_READWRITE);
+}
+
+static void ap3216c_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    k->event = ap3216c_event;
+    k->recv = ap3216c_recv;
+    k->send = ap3216c_send;
+    rc->phases.hold = ap3216c_reset_hold;
+}
+
+static const TypeInfo ap3216c_info = {
+    .name          = TYPE_AP3216C,
+    .parent        = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(AP3216CState),
+    .instance_init = ap3216c_init,
+    .class_init    = ap3216c_class_init,
+};
+
+static void ap3216c_register_types(void)
+{
+    type_register_static(&ap3216c_info);
+}
+
+type_init(ap3216c_register_types)
