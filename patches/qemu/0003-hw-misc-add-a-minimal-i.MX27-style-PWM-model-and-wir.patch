diff --git a/hw/misc/imx6ul_pwm.c b/hw/misc/imx6ul_pwm.c
new file mode 100644
index 0000000..61c63a4
--- /dev/null
+++ b/hw/misc/imx6ul_pwm.c
@@ -0,0 +1,140 @@
+/*
+ * i.MX27-style PWM block, as instantiated on i.MX6UL/6ULL (eight
+ * independent single-channel blocks with a 16-bit counter each).
+ *
+ * Minimal teaching model:
+ *  - plain register storage (the Linux pwm-imx27 driver applies a setting
+ *    by writing SAR/PR/CR and never reads back for verification, so
+ *    storage alone makes probe/apply succeed)
+ *  - computed "duty" / "period" / "enabled" properties expose the last
+ *    applied setting to QMP/HMP (qom-get), which is how tests and the
+ *    classroom observe "backlight at 60%" without a waveform framework
+ *
+ * Copyright (c) 2026 imx-forge contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/imx6ul_pwm.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+static uint64_t imx6ul_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX6ULPWMState *s = IMX6UL_PWM(opaque);
+
+    switch (offset) {
+    case 0x00:      /* PWMCR */
+        return s->pwmcr;
+    case 0x04:      /* PWMSR */
+        return s->pwmsr;
+    case 0x0c:      /* PWMSAR */
+        return s->pwmsar & 0xffff;
+    case 0x10:      /* PWMPR */
+        return s->pwmpr & 0xffff;
+    case 0x14:      /* PWMCNR — running counter not modeled, reads 0 */
+        return s->pwmcnr;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: read at bad offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+        return 0;
+    }
+}
+
+static void imx6ul_pwm_write(void *opaque, hwaddr offset, uint64_t value,
+                             unsigned size)
+{
+    IMX6ULPWMState *s = IMX6UL_PWM(opaque);
+
+    switch (offset) {
+    case 0x00:      /* PWMCR */
+        s->pwmcr = value;
+        break;
+    case 0x04:      /* PWMSR: FE/FWE/COMP/ROV are W1C status bits */
+        s->pwmsr &= ~value;
+        break;
+    case 0x0c:      /* PWMSAR */
+        s->pwmsar = value;
+        break;
+    case 0x10:      /* PWMPR */
+        s->pwmpr = value;
+        break;
+    case 0x14:      /* PWMCNR is read-only */
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: write at bad offset 0x%" HWADDR_PRIx "\n",
+                      __func__, offset);
+    }
+}
+
+static const MemoryRegionOps imx6ul_pwm_ops = {
+    .read = imx6ul_pwm_read,
+    .write = imx6ul_pwm_write,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+/* --- observable state for QMP/HMP -------------------------------------- */
+
+static bool imx6ul_pwm_get_enabled(Object *obj, Error **errp)
+{
+    return IMX6UL_PWM(obj)->pwmcr & 1;
+}
+
+static void imx6ul_pwm_reset_hold(Object *obj, ResetType type)
+{
+    IMX6ULPWMState *s = IMX6UL_PWM(obj);
+
+    s->pwmcr = 0;
+    s->pwmsr = 0;
+    s->pwmsar = 0;
+    s->pwmpr = 0x2;
+    s->pwmcnr = 0;
+}
+
+static void imx6ul_pwm_init(Object *obj)
+{
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    IMX6ULPWMState *s = IMX6UL_PWM(obj);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &imx6ul_pwm_ops, s,
+                          TYPE_IMX6UL_PWM, 0x18);
+    sysbus_init_mmio(sbd, &s->iomem);
+
+    object_property_add_bool(obj, "enabled", imx6ul_pwm_get_enabled, NULL);
+    object_property_add_uint16_ptr(obj, "duty", &s->pwmsar, OBJ_PROP_FLAG_READ);
+    object_property_add_uint16_ptr(obj, "period", &s->pwmpr, OBJ_PROP_FLAG_READ);
+}
+
+static void imx6ul_pwm_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = imx6ul_pwm_reset_hold;
+    dc->desc = "i.MX27-style PWM block (teaching model)";
+    dc->vmsd = NULL;
+}
+
+static const TypeInfo imx6ul_pwm_info = {
+    .name          = TYPE_IMX6UL_PWM,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX6ULPWMState),
+    .instance_init = imx6ul_pwm_init,
+    .class_init    = imx6ul_pwm_class_init,
+};
+
+static void imx6ul_pwm_register(void)
+{
+    type_register_static(&imx6ul_pwm_info);
+}
+
+type_init(imx6ul_pwm_register)
