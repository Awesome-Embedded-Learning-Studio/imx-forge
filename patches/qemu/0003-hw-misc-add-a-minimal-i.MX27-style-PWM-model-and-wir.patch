diff --git a/include/hw/misc/imx6ul_pwm.h b/include/hw/misc/imx6ul_pwm.h
new file mode 100644
index 0000000..085b59b
--- /dev/null
+++ b/include/hw/misc/imx6ul_pwm.h
@@ -0,0 +1,39 @@
+/*
+ * i.MX27-style PWM block, as instantiated on i.MX6UL/6ULL (eight
+ * independent single-channel blocks).
+ *
+ * Minimal teaching model: register storage plus computed duty-cycle and
+ * period properties (in guest-visible PWM counter ticks), so a guest
+ * pwm_apply is observable from QMP (qom-get on duty / period / enabled).
+ * No waveform is generated — QEMU has no PWM consumer framework.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef IMX6UL_PWM_H
+#define IMX6UL_PWM_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX6UL_PWM "imx6ul-pwm"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX6ULPWMState, IMX6UL_PWM)
+
+struct IMX6ULPWMState {
+    /*< private >*/
+    SysBusDevice parent_obj;
+
+    /*< public >*/
+    MemoryRegion iomem;
+
+    uint16_t pwmsar;   /* sample = duty counter ticks */
+    uint16_t pwmpr;    /* period counter ticks */
+    uint32_t pwmcr;    /* control: bit0 EN */
+    uint32_t pwmsr;    /* status (RO, mostly 0) */
+    uint32_t pwmcnr;   /* counter (RO) */
+};
+
+#endif /* IMX6UL_PWM_H */
