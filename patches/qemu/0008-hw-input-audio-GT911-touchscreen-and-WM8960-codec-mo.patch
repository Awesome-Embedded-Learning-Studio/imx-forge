+/* resolve the GT911 model: the machine creates it with id "gt911", so it
+ * is reachable as a direct child of the machine */
+static Object *gt911_find(Object *root)
+{
+    Object *found = object_resolve_path_component(root, "gt911");
+
+    if (found && object_dynamic_cast(found, TYPE_GT911)) {
+        return found;
+    }
+    return object_resolve_path("/machine/soc/i2c2/i2c-bus.1/child[0]", NULL);
+}
+
+void hmp_gt911_touch(Monitor *mon, const QDict *qdict)
+{
+    int x = qdict_get_int(qdict, "x");
+    int y = qdict_get_int(qdict, "y");
+    Object *obj = gt911_find(object_get_objects_root());
+
+    if (!obj) {
+        monitor_printf(mon, "gt911_touch: no gt911 device found\n");
+        return;
+    }
+    gt911_touch(GT911(obj), x, y);
+    monitor_printf(mon, "gt911_touch: (%d, %d) INT asserted\n", x, y);
+}
+
+void hmp_gt911_release(Monitor *mon, const QDict *qdict)
+{
+    Object *obj = gt911_find(object_get_objects_root());
+
+    if (!obj) {
+        monitor_printf(mon, "gt911_release: no gt911 device found\n");
+        return;
+    }
+    gt911_release(GT911(obj));
+    monitor_printf(mon, "gt911_release: INT asserted, next read clears\n");
+}
