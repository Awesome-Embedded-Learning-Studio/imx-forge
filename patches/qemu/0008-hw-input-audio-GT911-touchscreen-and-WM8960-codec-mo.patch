diff --git a/include/hw/input/gt911.h b/include/hw/input/gt911.h
new file mode 100644
index 0000000..4b37710
--- /dev/null
+++ b/include/hw/input/gt911.h
@@ -0,0 +1,63 @@
+/*
+ * Goodix GT911 capacitive touchscreen controller (I2C).
+ *
+ * Register-level teaching model aligned with the Linux goodix driver
+ * (drivers/input/touchscreen/goodix.c) as configured on the AES board:
+ * the touch IC answers as a GT911 (ID register "911", 8-byte contacts,
+ * 186-byte config page) even though the DT node is named gt9147 — the
+ * driver's chip-data table routes "911" to the gt911_chip_data.
+ *
+ * 16-bit register addressing (MSB first), matching goodix_i2c_read/write.
+ * Touch events are injected from the monitor:
+ *   (qemu) gt911_touch 512 300     # finger down at (512,300)
+ *   (qemu) gt911_release
+ * which fills the coordinate FIFO at 0x814e, raises the INT line
+ * (wired to GPIO1_IO9 by the machine), and the guest kernel's IRQ
+ * handler reads the point out through the real I2C path. Writing
+ * 0x814e (which the driver does after each read) clears the pending
+ * status and releases INT — the true GT911 handshake.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#ifndef HW_INPUT_GT911_H
+#define HW_INPUT_GT911_H
+
+#include "hw/i2c/i2c.h"
+#include "qom/object.h"
+
+#define TYPE_GT911 "gt911"
+OBJECT_DECLARE_SIMPLE_TYPE(GT911State, GT911)
+
+/* register map the driver touches */
+#define GT911_REG_COMMAND      0x8040
+#define GT911_REG_CONFIG_DATA  0x8047
+#define GT911_REG_ID           0x8140
+#define GT911_REG_COOR         0x814e
+#define GT911_REG_END          0x8150
+
+struct GT911State {
+    /*< private >*/
+    I2CSlave parent_obj;
+
+    /*< public >*/
+    uint16_t addr;          /* current register address (auto-increment) */
+    uint8_t addr_bytes;     /* 0/1/2: how many address bytes received */
+    uint16_t addr_latch;    /* MSB-first latch */
+
+    uint8_t id[6];          /* 0x8140: "911\0" + vid */
+
+    /* pending touch: status byte + one 8-byte contact + key footer */
+    bool pending;
+    uint16_t touch_x;
+    uint16_t touch_y;
+
+    qemu_irq int_line;      /* asserted low while a touch is pending */
+};
+
+/* monitor-side injection (hmp gt911_touch / gt911_release) */
+void gt911_touch(GT911State *s, uint16_t x, uint16_t y);
+void gt911_release(GT911State *s);
+
+#endif /* HW_INPUT_GT911_H */
