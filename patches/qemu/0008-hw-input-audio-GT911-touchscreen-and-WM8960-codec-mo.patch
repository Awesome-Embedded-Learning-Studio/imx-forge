diff --git a/hw/audio/wm8960.c b/hw/audio/wm8960.c
new file mode 100644
index 0000000..6ed3f1e
--- /dev/null
+++ b/hw/audio/wm8960.c
@@ -0,0 +1,121 @@
+/*
+ * Wolfson/Cirrus WM8960 audio codec — control-plane teaching model (I2C).
+ *
+ * The AES board wires the codec at i2c1 0x1a. The Linux wm8960 driver
+ * performs zero I2C reads during probe (it writes the reset register and
+ * powers up via regmap), so a register file with write/read-back makes
+ * the codec's control plane fully explorable from the guest:
+ *   i2cdetect -y 0          # 0x1a answers
+ *   i2cget/i2cset -y 0 0x1a # per-register DAPM experiments
+ *
+ * WM8960 register access is 7-bit register address + 9-bit data split
+ * across two bytes: byte0 = (reg << 1) | data[8], byte1 = data[7:0].
+ * Reads are byte-wise at the last written register pointer (the real
+ * chip only supports reads on a subset; the model allows all — this is
+ * a control-plane teaching model, not a bit-exact clone).
+ *
+ * Audio output (the SAI/SDMA data path) is intentionally NOT modeled:
+ * the fsl_sai driver unconditionally registers a dmaengine PCM and the
+ * SDMA engine is a firmware-driven core that a register model cannot
+ * honestly fake. Register-level codec analysis stays fully covered;
+ * sound stays a real-hardware exercise.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "hw/audio/wm8960.h"
+
+#define WM8960_NUM_REGS     64
+#define WM8960_REG_RESET    0x0f
+
+OBJECT_DECLARE_SIMPLE_TYPE(WM8960State, WM8960)
+
+struct WM8960State {
+    /*< private >*/
+    I2CSlave parent_obj;
+
+    /*< public >*/
+    uint16_t regs[WM8960_NUM_REGS];    /* 9-bit data per register */
+    uint8_t pointer;                   /* current register for reads */
+    bool first_byte;                   /* next tx byte carries (reg<<1|d8) */
+};
+
+static uint8_t wm8960_recv(I2CSlave *i2c)
+{
+    WM8960State *s = WM8960(i2c);
+
+    return s->regs[s->pointer % WM8960_NUM_REGS] & 0xff;
+}
+
+static int wm8960_send(I2CSlave *i2c, uint8_t data)
+{
+    WM8960State *s = WM8960(i2c);
+
+    if (s->first_byte) {
+        s->pointer = data >> 1;         /* 7-bit register address */
+        s->first_byte = false;
+        s->regs[s->pointer % WM8960_NUM_REGS] =
+            (s->regs[s->pointer % WM8960_NUM_REGS] & 0xff) |
+            ((data & 1) << 8);          /* 9th data bit rides along */
+        return 0;
+    }
+
+    s->regs[s->pointer % WM8960_NUM_REGS] =
+        (s->regs[s->pointer % WM8960_NUM_REGS] & 0x100) | data;
+
+    if (s->pointer == WM8960_REG_RESET) {
+        memset(s->regs, 0, sizeof(s->regs));
+    }
+    return 0;
+}
+
+static void wm8960_event(I2CSlave *i2c, enum i2c_event event)
+{
+    WM8960State *s = WM8960(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->first_byte = true;
+    }
+}
+
+static void wm8960_reset_hold(Object *obj, ResetType type)
+{
+    WM8960State *s = WM8960(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x19] = 0x1a;              /* hmm, AINLR: something non-zero
+                                        * so reads show life after reset */
+    s->pointer = 0;
+    s->first_byte = true;
+}
+
+static void wm8960_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    k->event = wm8960_event;
+    k->recv = wm8960_recv;
+    k->send = wm8960_send;
+    rc->phases.hold = wm8960_reset_hold;
+}
+
+static const TypeInfo wm8960_info = {
+    .name          = TYPE_WM8960,
+    .parent        = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(WM8960State),
+    .class_init    = wm8960_class_init,
+};
+
+static void wm8960_register_types(void)
+{
+    type_register_static(&wm8960_info);
+}
+
+type_init(wm8960_register_types)
