diff --git a/include/hw/sensor/icm20608.h b/include/hw/sensor/icm20608.h
new file mode 100644
index 0000000..31b1078
--- /dev/null
+++ b/include/hw/sensor/icm20608.h
@@ -0,0 +1,44 @@
+/*
+ * TDK InvenSense ICM20608 six-axis IMU (SPI).
+ *
+ * Minimal teaching model for the AES board (ecspi3):
+ * register-file semantics with bit7-of-address R/W framing, matching the
+ * Linux driver's spi_write_then_read() usage. Config registers are plain
+ * storage; the sensor data registers (0x3b..0x48, 14 bytes, big-endian
+ * 16-bit each) are derived from seven injectable QOM properties
+ * (accel-x/y/z, gyro-x/y/z, temp), so a classroom "rotate the board" is
+ * a QMP qom-set away and CI can assert readings through the real SPI
+ * path. WHO_AM_I (0x75) answers 0xAF.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#ifndef HW_SENSOR_ICM20608_H
+#define HW_SENSOR_ICM20608_H
+
+#include "hw/ssi/ssi.h"
+#include "qom/object.h"
+
+#define TYPE_ICM20608 "icm20608"
+OBJECT_DECLARE_SIMPLE_TYPE(ICM20608State, ICM20608)
+
+struct ICM20608State {
+    /*< private >*/
+    SSIPeripheral parent_obj;
+
+    /*< public >*/
+    uint8_t regs[0x80];     /* config/status storage */
+    bool reading;           /* in a read data phase */
+    uint8_t addr;           /* current read address (auto-increment) */
+    uint8_t waddr;          /* pending write address */
+    bool waddr_pending;     /* next tx byte is a write value */
+
+    /* injectable sample data (BE 16-bit each at 0x3b..0x48); stored as
+     * sign-extended uint16 so the QOM property helpers are happy */
+    uint16_t accel_x, accel_y, accel_z;
+    uint16_t gyro_x, gyro_y, gyro_z;
+    uint16_t temp;
+};
+
+#endif /* HW_SENSOR_ICM20608_H */
