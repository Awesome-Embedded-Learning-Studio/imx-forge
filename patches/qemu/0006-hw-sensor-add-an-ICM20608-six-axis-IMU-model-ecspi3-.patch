diff --git a/hw/sensor/icm20608.c b/hw/sensor/icm20608.c
new file mode 100644
index 0000000..e8532ea
--- /dev/null
+++ b/hw/sensor/icm20608.c
@@ -0,0 +1,150 @@
+/*
+ * TDK InvenSense ICM20608 six-axis IMU — teaching model (see header).
+ *
+ * Framing: first byte of a CS-low transaction is the address byte,
+ * bit7 = read; subsequent bytes are data, auto-incrementing (matches
+ * spi_write_then_read / spi_write from the Linux driver).
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * later. See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sensor/icm20608.h"
+#include "qemu/module.h"
+
+#define ICM_WHO_AM_I      0x75
+#define ICM_WHO_AM_I_VAL  0xaf
+
+/* data register window 0x3b..0x48: AXH AXL AYH AYL AZH AZL TH TL
+ * GXH GXL GYH GYL GZH GZL */
+static uint8_t icm20608_data_reg(ICM20608State *s, uint8_t reg)
+{
+    const uint16_t v[7] = {
+        s->accel_x, s->accel_y, s->accel_z,
+        s->temp,
+        s->gyro_x, s->gyro_y, s->gyro_z,
+    };
+    int idx = reg - 0x3b;
+
+    if (idx < 0 || idx >= 14) {
+        return 0;
+    }
+    /* big-endian 16-bit per sample */
+    return (idx & 1) ? (v[idx / 2] & 0xff) : ((v[idx / 2] >> 8) & 0xff);
+}
+
+static uint32_t icm20608_transfer(SSIPeripheral *ss, uint32_t tx)
+{
+    ICM20608State *s = ICM20608(ss);
+    uint32_t rx = 0xff;
+
+    /* The ECSPI controller exchanges whole 32-bit FIFO words (burst = 4
+     * bytes), so short transactions arrive padded with leading zero
+     * bytes. Framing therefore keys on the address byte itself: bit7 set
+     * starts a read at that address; while a read is in flight every
+     * dummy byte returns the next data byte; bit7-clear bytes outside a
+     * read form write pairs (address, value) — the pad zero just writes
+     * register 0 harmlessly. */
+    if (tx & 0x80) {
+        s->reading = true;
+        s->addr = tx & 0x7f;
+        return 0xff;
+    }
+
+    if (s->reading) {
+        if (s->addr == ICM_WHO_AM_I) {
+            rx = ICM_WHO_AM_I_VAL;
+        } else if (s->addr >= 0x3b && s->addr <= 0x48) {
+            rx = icm20608_data_reg(s, s->addr);
+        } else {
+            rx = s->regs[s->addr];
+        }
+        s->addr = (s->addr + 1) & 0x7f;
+        return rx;
+    }
+
+    if (s->waddr_pending) {
+        if (s->waddr < 0x3b || s->waddr > 0x48) {
+            s->regs[s->waddr] = tx;
+        }
+        s->waddr_pending = false;
+    } else {
+        s->waddr = tx;
+        s->waddr_pending = true;
+    }
+
+    return rx;
+}
+
+static void icm20608_reset_hold(Object *obj, ResetType type)
+{
+    ICM20608State *s = ICM20608(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[ICM_WHO_AM_I] = ICM_WHO_AM_I_VAL;
+    s->regs[0x6b] = 0x41;   /* PWR_MGMT_1: DEVICE_RESET | SLEEP on real hw */
+    s->reading = false;
+    s->addr = 0;
+    s->waddr = 0;
+    s->waddr_pending = false;
+
+    /* plausible stationary defaults: 1g on Z at +-16g (2048 LSB/g),
+     * rest ~0, 25 C (raw 250 in the driver's scaling) */
+    s->accel_x = 0;
+    s->accel_y = 0;
+    s->accel_z = 2048;
+    s->gyro_x = 0;
+    s->gyro_y = 0;
+    s->gyro_z = 0;
+    s->temp = 250;
+}
+
+static void icm20608_init(Object *obj)
+{
+    ICM20608State *s = ICM20608(obj);
+
+    object_property_add_uint16_ptr(obj, "accel-x", &s->accel_x,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "accel-y", &s->accel_y,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "accel-z", &s->accel_z,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "gyro-x", &s->gyro_x,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "gyro-y", &s->gyro_y,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "gyro-z", &s->gyro_z,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint16_ptr(obj, "temp", &s->temp,
+                                   OBJ_PROP_FLAG_READWRITE);
+}
+
+static void icm20608_realize(SSIPeripheral *ss, Error **errp)
+{
+}
+
+static void icm20608_class_init(ObjectClass *klass, void *data)
+{
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    k->realize = icm20608_realize;
+    k->transfer = icm20608_transfer;
+    rc->phases.hold = icm20608_reset_hold;
+}
+
+static const TypeInfo icm20608_info = {
+    .name          = TYPE_ICM20608,
+    .parent        = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(ICM20608State),
+    .instance_init = icm20608_init,
+    .class_init    = icm20608_class_init,
+};
+
+static void icm20608_register_types(void)
+{
+    type_register_static(&icm20608_info);
+}
+
+type_init(icm20608_register_types)
