// SPDX-License-Identifier: (GPL-2.0 OR MIT)
//
// QEMU variant of the AES board device tree.
//
// Baseline: self-built QEMU v11.1.0 (scripts/build_helper/build-qemu.sh,
// third_party/qemu submodule). On 11.1 the SoC model gives us: real models
// for UART/I2C/ECSPI/USDHC/FEC/GPIO/GPT/EPIT/WDOG/SNVS/eLCDIF, plus
// unimplemented stubs (reads 0, soft-fail) for MMDC/OCOTP/QSPI/USBMISC.
// The nodes below stay disabled because they are still raw address holes
// on 11.1 — a driver touching them takes an external abort during
// of_platform_populate and kills PID 1:
//   crypto@2280000 (dcp)                  - CAAM/AIPS3 region, hole on 11.1
//   rng@2284000 (rngb)                    - CAAM region, hole on 11.1
//   pxp@21cc000                           - hole (no model even on master)
//   csi@21c4000                           - hole (no model even on master)
//   touchscreen@2040000 (imx6ul_tsc)      - hole (no model even on master)
//
// Everything else (our LED/beep/key, i2c sensors, ecspi3, usdhc, both fec,
// can1, sai2, lcdif, usb...) is inherited from imx6ull-aes.dtsi unchanged —
// those drivers either find a real QEMU model or fail softly on a stub.
//
// Two QEMU-vs-real-boot differences are papered over here:
//   1. local-mac-address: on hardware U-Boot fixups the MAC into the fec
//      nodes before bootz; a direct-boot QEMU has no U-Boot, and without
//      this property of_get_mac_address() falls into the nvmem path, waits
//      forever for a cell and both FECs sit in deferred-prove limbo.
//   2. The disabled nodes above: unused or soft-failing on real hardware
//      too, so a single tree still serves both targets.
//
// Build with the kernel's dtc:  see scripts/qemu_helper/make-qemu-dtb.sh

/dts-v1/;

#include "imx6ull.dtsi"
#include "imx6ull-aes.dtsi"

/ {
	model = "Awesome Embedded Studio IMX6ULL (QEMU mcimx6ul-evk)";
	compatible = "fsl,imx6ull-14x14-evk", "fsl,imx6ull";
};

/*
 * QEMU sizes DRAM from the -m flag and rewrites the memory node at
 * arm_load_kernel time, so no memory override is needed here.
 */

/* still raw address holes on QEMU 11.1 (see header) */
&dcp {
	status = "disabled";
};

&rngb {
	status = "disabled";
};

&pxp {
	status = "disabled";
};

&csi {
	status = "disabled";
};

&tsc {
	status = "disabled";
};

/* no U-Boot to fixup the MAC before direct boot (see header) */
&fec1 {
	local-mac-address = [00 11 22 33 44 01];
};

&fec2 {
	local-mac-address = [00 11 22 33 44 02];
};
